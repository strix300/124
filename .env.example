# Все настройки app/core/config.py. Значения по умолчанию; .env не коммитить.

# Файлы и ограничения HTTP. Размеры — байты, таймауты — секунды. API-ключ обязателен (>=32 символов).
RAG_STORAGE_DIR=.data/documents
RAG_MODEL_CACHE_DIR=.data/models
RAG_API_KEY=
RAG_MAX_ACTIVE_REQUESTS=16
RAG_MAX_ACTIVE_QUESTIONS=2
RAG_MAX_JSON_BYTES=131072
RAG_REQUEST_BODY_TIMEOUT=60.0
RAG_PDF_PARSE_TIMEOUT=60.0
RAG_PDF_MEMORY_LIMIT_MB=1024
RAG_MAX_UPLOAD_BYTES=52428800
RAG_MULTIPART_OVERHEAD_BYTES=1048576
RAG_MAX_PAGE_CHARS=250000
RAG_MAX_DOCUMENT_CHARS=10000000
RAG_QUESTION_MAX_CHARS=2000
RAG_PAGE_SIZE_MAX=100

# Qdrant и Redis. В Compose подключения и пути переопределены в environment.
RAG_QDRANT_URL=http://localhost:6333
RAG_QDRANT_COLLECTION=documents
RAG_QDRANT_TIMEOUT=20
RAG_QDRANT_BATCH_SIZE=32
RAG_BROKER_URL=redis://localhost:6379/0
RAG_RESULT_BACKEND_URL=redis://localhost:6379/1
RAG_STATE_REDIS_URL=redis://localhost:6379/2
RAG_REDIS_TIMEOUT=5.0
RAG_REDIS_PREFIX=document-rag

# Фоновые задачи. Активные записи без TTL; терминальные и idempotency — секунды.
RAG_TERMINAL_TASK_TTL=604800
RAG_IDEMPOTENCY_TTL=604800
RAG_WORKER_CONCURRENCY=1
RAG_TASK_SOFT_LIMIT=3300
RAG_TASK_HARD_LIMIT=3600
RAG_VISIBILITY_TIMEOUT=3900
RAG_TASK_MAX_ATTEMPTS=3
RAG_TASK_RETRY_MAX_SECONDS=30
RAG_RECONCILIATION_INTERVAL=60
RAG_RECONCILIATION_BATCH_SIZE=100
RAG_STALE_TASK_SECONDS=4000

# Dense и sparse: изменение параметров индекса требует rag reindex.
RAG_DENSE_MODEL=intfloat/multilingual-e5-small
RAG_DENSE_REVISION=main
RAG_DENSE_DIMENSIONS=384
RAG_DENSE_QUERY_PREFIX="query: "
RAG_DENSE_DOCUMENT_PREFIX="passage: "
RAG_DENSE_MAX_TOKENS=512
RAG_EMBEDDING_BATCH_SIZE=16
RAG_SPARSE_MODEL=Qdrant/bm25
RAG_BM25_LANGUAGE=russian
RAG_BM25_DISABLE_STEMMER=false
RAG_BM25_K=1.2
RAG_BM25_B=0.75
RAG_BM25_AVG_LEN=256.0
RAG_CHUNK_TOKENS=240
RAG_CHUNK_OVERLAP_TOKENS=35
RAG_DENSE_CANDIDATES=40
RAG_SPARSE_CANDIDATES=40
RAG_FUSED_CANDIDATES=30
RAG_FUSION=rrf

# Реранкер и общий лимит одновременно исполняемых этапов inference.
RAG_RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RAG_RERANKER_REVISION=main
RAG_RERANKER_INPUT_LIMIT=30
RAG_RERANKER_OUTPUT_LIMIT=5
RAG_RERANKER_BATCH_SIZE=8
RAG_RERANKER_MAX_TOKENS=512
RAG_MODEL_DEVICE=cuda
RAG_INFERENCE_THREADS=4
RAG_INFERENCE_SLOTS=1
RAG_INFERENCE_WAIT_SECONDS=30.0
RAG_INDEXING_INFERENCE_WAIT_SECONDS=1500.0
RAG_LOCK_LEASE_SECONDS=60
RAG_DOCUMENT_LOCK_WAIT_SECONDS=5.0
RAG_LOCK_POLL_SECONDS=0.1

# Только локальный Ollama. Генератор и verifier вызываются отдельно.
RAG_OLLAMA_URL=http://localhost:11434
RAG_GENERATION_MODEL=qwen2.5:7b-instruct-q4_K_M
RAG_VERIFICATION_MODEL=qwen2.5:7b-instruct-q4_K_M
RAG_OLLAMA_CONTEXT_TOKENS=16384
RAG_LLM_OUTPUT_TOKENS=1200
RAG_LLM_TIMEOUT=300.0
RAG_LLM_KEEP_ALIVE=5m
RAG_LLM_LOG_OUTPUTS=false
RAG_OLLAMA_NUM_GPU=-1
RAG_CONTEXT_MAX_BYTES=8000

# Общий срок ответа и повторы временных сетевых ошибок.
RAG_ANSWER_DEADLINE_SECONDS=1300.0
RAG_RETRY_ATTEMPTS=3
RAG_RETRY_MIN_SECONDS=0.5
RAG_RETRY_MAX_SECONDS=4.0
RAG_LOG_LEVEL=INFO
RAG_DOWNLOAD_TIMEOUT=3600.0

# Только Compose: адрес Ollama из контейнеров (для внешнего локального сервера).
# RAG_CONTAINER_OLLAMA_URL=http://host.docker.internal:11434
